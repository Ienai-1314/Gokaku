# 腾讯云 CloudBase（云开发）
# 在 https://console.cloud.tencent.com/tcb 创建环境后获取
TCB_ENV_ID=your_env_id               # 云开发环境 ID，如 prod-xxxxxx
TCB_SECRET_ID=your_secret_id         # 腾讯云 API 密钥 SecretId
TCB_SECRET_KEY=your_secret_key       # 腾讯云 API 密钥 SecretKey

# DeepSeek API
# 在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_deepseek_api_key

# 语法数据文件目录（服务端读取本地 JSON 用）
DATA_DIR=d:/量化n1/structured_data
